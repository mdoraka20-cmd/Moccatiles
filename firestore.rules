rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions (only used on single-doc operations, never on list)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Shop Configuration
    match /shop/{configId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(configId);
    }

    // Products
    match /products/{productId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(productId);
    }

    // Customers
    match /customers/{customerId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(customerId);
    }

    // Invoices
    match /invoices/{invoiceNo} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(invoiceNo);
    }

    // Payments
    match /payments/{paymentId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(paymentId);
    }

    // Transactions (Income & Expenses)
    match /txns/{txnId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(txnId);
    }

    // Dealers
    match /dealers/{dealerId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(dealerId);
    }

    // Application Users
    match /users/{userId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(userId);
    }

    // Stock In Records
    match /stockInRecords/{stockInId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(stockInId);
    }

    // Delivery Challans
    match /deliveryChallans/{challanId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(challanId);
    }

    // Metadata (Categories, Vendors, Staff Permissions, SMS Settings)
    match /metadata/{metaId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(metaId);
    }

    // SMS Logs & Delivery Reports
    match /smsLogs/{logId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(logId);
    }

    // Connection testing
    match /test/{docId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(docId);
    }
  }
}
