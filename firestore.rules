rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Shop Configuration
    match /shop/{configId} {
      allow read, write: if isValidId(configId);
    }

    // Products
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Invoices
    match /invoices/{invoiceNo} {
      allow read, write: if isValidId(invoiceNo);
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if isValidId(paymentId);
    }

    // Transactions (Income & Expenses)
    match /txns/{txnId} {
      allow read, write: if isValidId(txnId);
    }

    // Dealers
    match /dealers/{dealerId} {
      allow read, write: if isValidId(dealerId);
    }

    // Application Users
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Stock In Records
    match /stockInRecords/{stockInId} {
      allow read, write: if isValidId(stockInId);
    }

    // Delivery Challans
    match /deliveryChallans/{challanId} {
      allow read, write: if isValidId(challanId);
    }

    // Metadata (Categories, Vendors, Staff Permissions)
    match /metadata/{metaId} {
      allow read, write: if isValidId(metaId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
